generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// The connection address is in prisma.config.ts (DATABASE_URL): Prisma 7 no longer takes a url here
datasource db {
  provider = "postgresql"
}

/// A family tree: a separately managed set of data. Every person belongs to exactly one family tree;
/// relations, life events and notes hang off the person, media and imports carry the family tree themselves.
/// Archives, sources and citations belong to no family tree: one library for all of them.
model FamilyTree {
  id          String    @id @default(uuid())
  name        String
  description String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Possible errors the user marked as right (keys of lib/plausibility/checks.ts)
  checkedIssues String[] @default([])
  /// Home person: the start of the ancestor figures, the reports and the family tree page. No foreign key – the family
  /// trees are restored before their persons; a deleted person counts as none
  homePersonId  String?

  persons Person[]
  media   Media[]
  imports ImportRecord[]
}

model Person {
  id                 String    @id @default(uuid())
  familyTreeId       String
  firstName          String
  lastName           String?
  middleName         String?
  birthName          String?
  title              String?
  nickname           String?
  birthDate          String?
  birthDatePrecision String? // "EXACT", "MONTH", "YEAR", "APPROXIMATE"
  birthPlace         String?
  gender             String    @default("UNKNOWN") // "MALE", "FEMALE", "UNKNOWN"
  deathDate          String?
  deathDatePrecision String?
  deathPlace         String?
  address            String?
  phone              String?
  email              String?
  occupation         String?
  hobbies            String?
  maritalStatus      String? // "SINGLE", "MARRIED", "DIVORCED", "WIDOWED", "CIVIL_PARTNERSHIP"
  nationality        String?
  languages          String[]
  profilePictureId   String?
  // Cologne phonetics of all name parts (phonetic search, duplicate hint); maintained by the backend
  phonetics          String[]  @default([])
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relationen
  familyTree   FamilyTree       @relation(fields: [familyTreeId], references: [id])
  relationsAsA Relation[]       @relation("PersonA")
  relationsAsB Relation[]       @relation("PersonB")
  events       Event[]
  notes        Note[]
  media        Media[]
  citations    PersonCitation[]

  @@index([phonetics], type: Gin)
  @@index([familyTreeId])
}

model Relation {
  id        String    @id @default(uuid())
  personAId String
  personBId String
  type      String // "MOTHER", "FATHER", "CHILD", "SIBLING", "HUSBAND", "WIFE", "LIFE_PARTNER", "PARTNER", "OTHER"
  label     String? // z.B. "Adoptivkind"
  active    Boolean   @default(true)
  note      String?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  personA Person @relation("PersonA", fields: [personAId], references: [id])
  personB Person @relation("PersonB", fields: [personBId], references: [id])

  citations RelationCitation[]

  // PostgreSQL does not index foreign keys automatically – without an index every query
  // or every deletion of a person scans the whole table
  @@index([personAId])
  @@index([personBId])
}

model Event {
  id            String   @id @default(uuid())
  personId      String
  date          String?
  datePrecision String?
  title         String
  category      String
  description   String?
  place         String?
  sortOrder     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  person    Person          @relation(fields: [personId], references: [id])
  // Linked files (map, photo, certificate …) – also media of other persons, e.g. a group photo
  media     EventMedia[]
  citations EventCitation[]

  @@index([personId])
}

model Note {
  id        String   @id @default(uuid())
  personId  String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id])

  @@index([personId])
}

/// A file. Media of a person or an event belong to its family tree; scans of sources and citations belong to the
/// library (no family tree, no person).
model Media {
  id               String   @id @default(uuid())
  familyTreeId     String?
  /// Person the file belongs to (media tab); it can be linked with events of any person
  personId         String?
  fileName         String
  originalFileName String
  mimeType         String
  sizeBytes        BigInt
  type             String // "PROFILE_PICTURE", "DOCUMENT", "PHOTO", "OTHER"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  familyTree FamilyTree?     @relation(fields: [familyTreeId], references: [id], onDelete: Restrict)
  person     Person?         @relation(fields: [personId], references: [id])
  events     EventMedia[]
  sources    SourceMedia[]
  citations  CitationMedia[]

  @@index([personId])
  @@index([familyTreeId])
}

/// Link event ↔ medium (n:m); deleted together with the event or the medium
model EventMedia {
  eventId   String
  mediaId   String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([eventId, mediaId])
  @@index([mediaId])
}

/// Log of executed imports (version history, §2.8): which file was imported when, with which result
model ImportRecord {
  id                String    @id @default(uuid())
  familyTreeId      String
  importedAt        DateTime  @default(now())
  fileName          String
  /// SHA-256 of the file content – detects a repeated import of the same file
  fileHash          String
  kind              String // "ZIP", "GEDCOM"
  source            String?
  /// State of the file according to its header (export time)
  exportedAt        DateTime?
  strategy          String
  createdPersons    Int
  updatedPersons    Int
  removedPersons    Int
  recognizedPersons Int       @default(0)
  createdRelations  Int
  createdEvents     Int
  createdNotes      Int
  createdMedia      Int
  missingFiles      Int

  familyTree FamilyTree @relation(fields: [familyTreeId], references: [id])

  @@index([fileHash])
  @@index([importedAt])
  @@index([familyTreeId])
}

/// Archive, library, registry office, website … where sources are kept (GEDCOM REPO); shared by all family trees
model Repository {
  id        String    @id @default(uuid())
  name      String
  address   String?
  url       String?
  email     String?
  phone     String?
  note      String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sources Source[]
}

/// A document or work (GEDCOM SOUR record); shared by all family trees
model Source {
  id           String    @id @default(uuid())
  type         String    @default("OTHER") // CHURCH_BOOK, CIVIL_REGISTER, CENSUS, NEWSPAPER, BOOK, LETTER, GRAVESTONE, WEBSITE, INTERVIEW, DOCUMENT, OTHER
  title        String
  author       String?
  /// Publisher, place and year – or the address of a website
  publication  String?
  /// Short title for lists
  abbreviation String?
  /// Transcription of the whole source
  text         String?
  repositoryId String?
  /// Shelf mark, film or record number in the archive
  callNumber   String?
  note         String?
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  repository Repository?   @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  citations  Citation[]
  media      SourceMedia[]

  @@index([repositoryId])
}

/// One entry of a source (page, transcription, quality); supports any number of facts, also in several family trees
model Citation {
  id            String   @id @default(uuid())
  sourceId      String
  /// Page, entry number, folio or the address of the single record
  page          String?
  /// Date of the entry, flexible like all dates of the app
  date          String?
  datePrecision String?
  /// Transcription of the entry
  text          String?
  /// GEDCOM QUAY: 0 unreliable, 1 questionable, 2 secondary, 3 primary
  quality       Int?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  source    Source             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  media     CitationMedia[]
  persons   PersonCitation[]
  events    EventCitation[]
  relations RelationCitation[]

  @@index([sourceId])
}

/// Link source ↔ medium (scan of the whole source)
model SourceMedia {
  sourceId  String
  mediaId   String
  createdAt DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  media  Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([sourceId, mediaId])
  @@index([mediaId])
}

/// Link citation ↔ medium (scan of the single page or entry)
model CitationMedia {
  citationId String
  mediaId    String
  createdAt  DateTime @default(now())

  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([citationId, mediaId])
  @@index([mediaId])
}

/// A citation supports a fact of a person: GENERAL (the person as a whole), NAME, BIRTH or DEATH – birth and death are
/// fields of the person, not events
model PersonCitation {
  personId   String
  citationId String
  fact       String   @default("GENERAL")
  createdAt  DateTime @default(now())

  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([personId, citationId, fact])
  @@index([citationId])
}

/// A citation supports a life event
model EventCitation {
  eventId    String
  citationId String
  createdAt  DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([eventId, citationId])
  @@index([citationId])
}

/// A citation supports a relation (e.g. a marriage, a parent and a child)
model RelationCitation {
  relationId String
  citationId String
  createdAt  DateTime @default(now())

  relation Relation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([relationId, citationId])
  @@index([citationId])
}
