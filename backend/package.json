{
  "name": "cognatio-backend",
  "version": "1.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Backend of Cognatio (GraphQL API, REST routes, Prisma)",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "test": "jest",
    "lint": "eslint src",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express4": "^1.1.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fflate": "^0.8.3",
    "graphql": "^16.8.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.22.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jest-mock-extended": "^4.0.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.19.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.1"
  }
}
