{
  "name": "cognatio",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "description": "Cognatio – family tree application (monorepo: backend, frontend, e2e, desktop)",
  "workspaces": [
    "backend",
    "frontend",
    "e2e",
    "desktop"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "lint": "npm run lint -w backend -w frontend -w desktop",
    "test": "npm run test -w backend -w frontend",
    "test:e2e": "npm run test -w e2e",
    "build": "npm run build -w backend -w frontend",
    "postgres:fetch": "node scripts/fetch-postgres.mjs",
    "db:start": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop",
    "db:status": "node scripts/dev-db.mjs status",
    "db:backup": "node scripts/dev-db.mjs backup",
    "db:restore": "node scripts/dev-db.mjs restore",
    "version": "node scripts/sync-version.mjs && git add backend/package.json frontend/package.json e2e/package.json desktop/package.json package-lock.json",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:check": "node scripts/sync-version.mjs --check",
    "desktop:dev": "npm run build -w backend -w frontend && npm run start -w desktop",
    "desktop:dist": "npm run dist -w desktop",
    "test:desktop": "npm run test -w desktop",
    "test:scripts": "node --test \"scripts/*.test.mjs\" \"desktop/scripts/*.test.mjs\"",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run",
    "release:beta": "commit-and-tag-version --prerelease beta",
    "release:beta:dry": "commit-and-tag-version --prerelease beta --dry-run",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  },
  "allowScripts": {
    "@apollo/protobufjs@1.2.8": true,
    "@prisma/engines@^7.8.0": true,
    "electron@44.7.0": true,
    "prisma@^7.8.0": true
  },
  "devDependencies": {
    "commit-and-tag-version": "^13.2.1",
    "prettier": "^3.2.5"
  }
}
