{
  "name": "cognatio-desktop",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "description": "Desktop app of Cognatio for Windows and Linux (Electron shell around the backend with the bundled PostgreSQL)",
  "author": "Cognatio",
  "homepage": "https://github.com/Orodion/Cognatio",
  "main": "dist/main.js",
  "desktopName": "cognatio.desktop",
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle.mjs",
    "start": "npm run build && electron .",
    "stage": "node scripts/stage.mjs",
    "dist": "npm run build && node scripts/stage.mjs && electron-builder --win",
    "dist:linux": "npm run build && node scripts/stage.mjs && electron-builder --linux",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint src",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "playwright-core": "1.63.0",
    "tsx": "^4.19.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.1"
  }
}
